# TaskFlow Frontend Environment Configuration

# Local Development:
# Use relative path /api so Vite proxy (port 5173 -> port 8000) handles requests seamlessly
VITE_API_BASE_URL=/api

# Production (Vercel):
# Set this in your Vercel Project Settings -> Environment Variables:
# VITE_API_URL=https://taskflow-2-bzh0.onrender.com
